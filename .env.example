SECRET_KEY=
DATABASE_URL=sqlite:///app.db
PORT=8000
FLASK_DEBUG=false
FORCE_HTTPS=true
TRUSTED_PROXY=false
CSRF_ENABLED=true
CORS_ORIGINS=
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_STORAGE_URL=
# kosong = ikut FORCE_HTTPS
TALISMAN_ENABLED=
# kosong = pakai DEFAULT_CSP. isi untuk override, mis. tambah sumber CDN.
TALISMAN_CSP=
LOG_LEVEL=INFO
# kosong = data/app.log
LOG_FILE=
ALERT_WEBHOOK_URL=
INTERNAL_API_TOKEN=
MIGRATE_ON_BOOT=false
# false = noindex + robots.txt disallow
SEO_INDEXABLE=true
# atribut lang + tag SEO di index.html
APP_LANG=en
SQLALCHEMY_POOL_SIZE=10
SQLALCHEMY_MAX_OVERFLOW=20
SQLALCHEMY_POOL_TIMEOUT=30
SQLALCHEMY_POOL_RECYCLE=1800
